from pathlib import Path
import subprocess,json,time
r=Path(__file__).parent;p=r/'package'
script='''set -euo pipefail
python /qualification/verify_stage.py
python -m pip install --no-index --no-deps --force-reinstall --no-compile /qualification/tensorfold-0.6.6-cp311-abi3-linux_x86_64.whl
bash -n /qualification/bootstrap.sh
bash -n /qualification/launch-command.sh
python - <<'CHECK'
import importlib.util,pathlib
p=pathlib.Path('/qualification/run_controls.py')
s=importlib.util.spec_from_file_location('dense_controls',p);m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
assert callable(m.main)
print('frozen Dense32 target-policy runner guarded import/shell/manifest PASS;GPUmain notexecuted')
CHECK
'''
argv=['docker','run','--rm','--network','none','--cpus','1','--memory','3g','-e','PYTHONDONTWRITEBYTECODE=1','-e','CUDA_VISIBLE_DEVICES=','--mount',f'type=bind,src={p},dst=/qualification,readonly','--entrypoint','/bin/bash','sha256:30fda46a4c40422e055e0615a8186fc1c39678be9c8c9761885fc0cb77c28993','-c',script]
(r/'package-cpu-command.json').write_text(json.dumps({'argv':argv,'cwd':'/home/kklouzal'},indent=2)+'\n')
with (r/'package-cpu.log').open('w') as f:code=subprocess.run(argv,stdout=f,stderr=subprocess.STDOUT,cwd='/home/kklouzal').returncode
(r/'package-cpu-exit.json').write_text(json.dumps({'exit':code,'finished':time.time()})+'\n');print(code)
