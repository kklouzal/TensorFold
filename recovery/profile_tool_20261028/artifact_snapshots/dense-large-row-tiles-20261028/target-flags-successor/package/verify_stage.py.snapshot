from pathlib import Path
import hashlib,json
root=Path('/qualification')
for name,row in json.loads((root/'stage-files.json').read_text()).items():
    path=root/name
    if not path.is_file() or path.stat().st_size!=row['bytes'] or hashlib.sha256(path.read_bytes()).hexdigest()!=row['sha256']:raise RuntimeError('staged artifact mismatch '+name)
print('exact staged files verified',flush=True)
