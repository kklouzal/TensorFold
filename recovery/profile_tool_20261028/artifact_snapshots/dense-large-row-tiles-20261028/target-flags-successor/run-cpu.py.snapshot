from pathlib import Path
import json,subprocess,time
r=Path(__file__).parent
script='''set -euo pipefail
python -m pip install --no-index --no-deps --force-reinstall --no-compile /app-artifact/wheels/*.whl
python /evidence/verify-wheel.py
python -m pytest -c /dev/null -o 'pythonpath=/source/tests /source' -p no:cacheprovider -q /source/tests/test_dense_target_math_region.py
python -m pytest -c /dev/null -o 'pythonpath=/source/tests /source/tests/cuda /source' -p no:cacheprovider --collect-only -q /source/tests/cuda/test_sm70_large_dense_tiles.py
python -m ruff check --no-cache /source/tests/test_dense_target_math_region.py /source/tests/cuda/test_sm70_large_dense_tiles.py
'''
argv=['docker','run','--rm','--network','none','--cpus','1','--memory','4g','-e','PYTHONDONTWRITEBYTECODE=1','-e','CUDA_VISIBLE_DEVICES=','--mount','type=bind,src=/Warehouse/TensorFold-wt/v100-dense-large-row-targetflags-20261028,dst=/source,readonly','--mount',f'type=bind,src={r},dst=/evidence','--mount',f'type=bind,src={r.parent},dst=/app-artifact,readonly','--entrypoint','/bin/bash','sha256:30fda46a4c40422e055e0615a8186fc1c39678be9c8c9761885fc0cb77c28993','-c',script]
(r/'cpu-command.json').write_text(json.dumps({'argv':argv,'cwd':'/home/kklouzal'},indent=2)+'\n')
with (r/'cpu.log').open('w') as f:code=subprocess.run(argv,stdout=f,stderr=subprocess.STDOUT,cwd='/home/kklouzal').returncode
(r/'cpu-exit.json').write_text(json.dumps({'exit':code,'finished':time.time()})+'\n');print(code)
