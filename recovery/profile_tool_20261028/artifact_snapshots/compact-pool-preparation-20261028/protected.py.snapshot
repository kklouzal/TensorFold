from pathlib import Path
import hashlib,json,sys
r=Path('/evidence')
record={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for base in ['/opt/tensorfold-pins','/opt/tensorfold-media-pins'] for p in sorted(Path(base).rglob('*')) if p.is_file()}
if sys.argv[1]=='after':
 assert record==json.loads((r/'protected-before.json').read_text()), 'protected closure changed'
(r/('protected-'+sys.argv[1]+'.json')).write_text(json.dumps(record,indent=2)+'\n')
print('protected closure '+sys.argv[1]+' PASS',flush=True)
