"""Read-only reconciliation. Resolve immutable Git blobs, never the DP4A WIP tree."""
import ast, hashlib, json, subprocess
from pathlib import Path
from datetime import datetime, timezone
B=Path('/Warehouse/TensorFold-portable-audit-20261026/gpu-wait-inventory-20261028')
A=B.parent
REPO=Path('/Warehouse/TensorFold-wt/v100-dp4a-target-enrollment-20261028')
COMMITS=['28ac5b2da8660542c156adf60b8a3e5072b89244','f0300ac8166349882a3de5f82687e0bf836eeff5']
OLD='7de2259b1a402542b91fde9e906a9ebb07f4c949'
def digest(data):return hashlib.sha256(data).hexdigest()
def load(p):return json.loads(p.read_text())
cache={}
def source(commit,path):
 key=(commit,path)
 if key not in cache:
  raw=subprocess.check_output(['git','-C',str(REPO),'show',f'{commit}:{path}'])
  cache[key]=(raw,ast.parse(raw))
 return cache[key]
def functions(tree):
 result={}
 def walk(n,prefix=''):
  for x in ast.iter_child_nodes(n):
   if isinstance(x,(ast.ClassDef,ast.FunctionDef,ast.AsyncFunctionDef)):
    name=prefix+x.name
    if not isinstance(x,ast.ClassDef):result[name]=x
    walk(x,name+'.')
   else:walk(x,prefix)
 walk(tree);return result

def anchors(path,line):
 raw,t=source(OLD,path);fs=functions(t)
 containing=[(k,n) for k,n in fs.items() if n.lineno<=line<=n.end_lineno]
 if containing:name,_=min(containing,key=lambda pair:pair[1].end_lineno-pair[1].lineno)
 else:name=None
 result=[]
 for commit in COMMITS:
  data,tree=source(commit,path);current=functions(tree)
  n=current.get(name)
  result.append({'commit':commit,'path':path,'sha256':digest(data),'original_function':name,
   'current_function':name if n else None,'line':n.lineno if n else None,'end_line':n.end_lineno if n else None,
   'same_function_AST_as_7de':ast.dump(n,include_attributes=False)==ast.dump(fs[name],include_attributes=False) if n else None,
   'resolution':'immutable Git blob; local DP4A worktree has unrelated uncommitted enrollment WIP and is excluded'})
 return result

