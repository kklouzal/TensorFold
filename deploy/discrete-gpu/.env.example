# Copy to .env and replace the image and all four absolute host paths.
# Use an immutable image ID/digest or a recorded build tag from this fork.
TENSORFOLD_IMAGE=tensorfold-fork:local
TF_MODEL_DIR=/absolute/path/to/Qwen3.8-Flash-Next-exl3
TF_CACHE_DIR=/absolute/path/to/tensorfold-kernel-cache
TF_TMP_DIR=/absolute/path/to/tensorfold-tmp
TF_WORK_DIR=/absolute/path/to/tensorfold-work

# Loopback by default. Set an explicit host interface for trusted remote clients.
TF_BIND_IP=127.0.0.1
TF_PORT=8080
