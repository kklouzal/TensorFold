# Copy to .env and replace the image and all four absolute host paths.
# Use an immutable image ID/digest or a recorded build tag from this fork.
TENSORFOLD_IMAGE=tensorfold-fork:local
TF_MODEL_DIR=/absolute/path/to/Qwen3.8-Flash-Next-exl3
TF_CACHE_DIR=/absolute/path/to/tensorfold-kernel-cache
TF_TMP_DIR=/absolute/path/to/tensorfold-tmp
TF_WORK_DIR=/absolute/path/to/tensorfold-work

# Loopback by default. Set an explicit host interface for trusted remote clients.
TF_BIND_IP=127.0.0.1
TF_PORT=8080

# Both memory and memory-plus-swap limits use this byte count (no extra swap).
# 56 decimal GB is the recorded EXL3 profile, not a universal checkpoint budget.
TF_RAM_BYTES=56000000000
# Use no for a single admission/startup attempt, or on-failure:3 for Docker's
# bounded failure retry policy. Docker remains the only restart owner.
TF_RESTART_POLICY=unless-stopped

# Optional compose.gpus.yaml selects this NVIDIA UUID through device requests.
# Obtain the actual value with nvidia-smi -L; an index is less stable.
# TF_GPU_UUID=GPU-00000000-0000-0000-0000-000000000000
# Optional compose.cdi.yaml instead uses one exact name from nvidia-ctk cdi list.
# TF_CDI_DEVICE=nvidia.com/gpu=GPU-00000000-0000-0000-0000-000000000000
