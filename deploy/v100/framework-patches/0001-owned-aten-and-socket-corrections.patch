diff --git a/test/cpp/c10d/SocketTest.cpp b/test/cpp/c10d/SocketTest.cpp
new file mode 100644
index 0000000..e9fcc34
--- /dev/null
+++ b/test/cpp/c10d/SocketTest.cpp
@@ -0,0 +1,103 @@
+// Copyright (c) Meta Platforms, Inc. and affiliates.
+// All rights reserved.
+//
+// This source code is licensed under the BSD-style license found in the
+// LICENSE file in the root directory of this source tree.
+
+#include <torch/csrc/distributed/c10d/socket_fmt.h>
+
+#include <arpa/inet.h>
+#include <netdb.h>
+
+#include <atomic>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+namespace {
+std::atomic<bool> fail_lookup{false};
+std::atomic<unsigned> lookup_calls{0};
+} // namespace
+
+extern "C" int __wrap_getnameinfo(
+    const sockaddr* addr,
+    socklen_t,
+    char* host,
+    socklen_t host_len,
+    char* service,
+    socklen_t service_len,
+    int flags) {
+  lookup_calls.fetch_add(1, std::memory_order_relaxed);
+  if (fail_lookup.load(std::memory_order_relaxed)) {
+    return EAI_FAIL;
+  }
+  const char* name =
+      addr->sa_family == AF_INET ? "ipv4.example" : "ipv6.example";
+  if (host_len <= std::strlen(name) || service_len <= std::strlen("12345") ||
+      flags != NI_NUMERICSERV) {
+    return EAI_OVERFLOW;
+  }
+  std::strcpy(host, name);
+  std::strcpy(service, "12345");
+  return 0;
+}
+
+TEST(SocketTest, AddressFormattingAndConcurrentFailurePolicy) {
+  sockaddr_in ipv4{};
+  ipv4.sin_family = AF_INET;
+  ipv4.sin_port = htons(12345);
+  ASSERT_EQ(inet_pton(AF_INET, "192.0.2.17", &ipv4.sin_addr), 1);
+  const auto* addr4 = reinterpret_cast<const sockaddr*>(&ipv4);
+  sockaddr_in6 ipv6{};
+  ipv6.sin6_family = AF_INET6;
+  ipv6.sin6_port = htons(12345);
+  ASSERT_EQ(inet_pton(AF_INET6, "2001:db8::17", &ipv6.sin6_addr), 1);
+  const auto* addr6 = reinterpret_cast<const sockaddr*>(&ipv6);
+
+  EXPECT_EQ(
+      c10d::detail::formatSockAddr(addr4, sizeof(ipv4)), "ipv4.example:12345");
+  EXPECT_EQ(
+      c10d::detail::formatSockAddr(addr6, sizeof(ipv6)),
+      "[ipv6.example]:12345");
+  EXPECT_EQ(lookup_calls.load(std::memory_order_relaxed), 2);
+
+  fail_lookup.store(true, std::memory_order_relaxed);
+  std::atomic<bool> start{false};
+  std::atomic<unsigned> mismatches{0};
+  std::vector<std::thread> workers;
+  for (unsigned worker = 0; worker < 8; ++worker) {
+    workers.emplace_back([&] {
+      while (!start.load(std::memory_order_acquire)) {
+        std::this_thread::yield();
+      }
+      for (unsigned iteration = 0; iteration < 1000; ++iteration) {
+        if (c10d::detail::formatSockAddr(addr4, sizeof(ipv4)) !=
+                "192.0.2.17:12345" ||
+            c10d::detail::formatSockAddr(addr6, sizeof(ipv6)) !=
+                "[2001:db8::17]:12345") {
+          mismatches.fetch_add(1, std::memory_order_relaxed);
+        }
+      }
+    });
+  }
+  start.store(true, std::memory_order_release);
+  for (auto& worker : workers) {
+    worker.join();
+  }
+  EXPECT_EQ(mismatches.load(std::memory_order_relaxed), 0);
+  const auto calls_after_failure = lookup_calls.load(std::memory_order_relaxed);
+  EXPECT_GE(calls_after_failure, 3);
+  EXPECT_EQ(
+      c10d::detail::formatSockAddr(addr4, sizeof(ipv4)), "192.0.2.17:12345");
+  EXPECT_EQ(
+      c10d::detail::formatSockAddr(addr6, sizeof(ipv6)),
+      "[2001:db8::17]:12345");
+  EXPECT_EQ(lookup_calls.load(std::memory_order_relaxed), calls_after_failure);
+  sockaddr unsupported{};
+  unsupported.sa_family = AF_UNSPEC;
+  EXPECT_EQ(
+      c10d::detail::formatSockAddr(&unsupported, sizeof(unsupported)),
+      "?UNKNOWN?");
+}
