@@ -189,6 +189,16 @@ class ContainsReturnChecker(ast.NodeVisitor):
         return self.visit(node.func)
 
 
+def _module_annotations(gscope):
+    # PEP 649/749 (Python 3.14+): module globals hold __annotate__ until
+    # __annotations__ is first accessed; resolve names like eager evaluation.
+    annotations = gscope.get("__annotations__")
+    if annotations is None and (annotate := gscope.get("__annotate__")) is not None:
+        import annotationlib
+        annotations = annotationlib.call_annotate_function(annotate, annotationlib.Format.FORWARDREF)
+    return annotations or {}
+
+
 class CodeGenerator(ast.NodeVisitor):
 
     def __init__(self, context, prototype, gscope, attributes, constants, function_name, jit_fn: JITFunction, options,
@@ -260,7 +270,7 @@ class CodeGenerator(ast.NodeVisitor):
