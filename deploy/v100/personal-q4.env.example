# Personal V100 Q4 KV profile (the Compose production default): RotorQuant
# iso64-norm4-h64, 32 complete 262,144-token windows; ceilings are not hardware qualification.
TF_KV_DTYPE=rotorquant-iso64-norm4-h64
TF_CONTEXT=262144
TF_PARALLEL=32
TF_KV_FULL_WINDOWS=32
TF_MAX_PENDING_REQUESTS=64
TF_MAX_HTTP_CONNECTIONS=65
TF_MAX_WAITING_INPUT_BYTES=603981568
TF_DRAFT_METHOD=mtp
TF_DRAFTS=4
