From a851b028ecbd5f843eb1fc05b93cc2d0abed0de3 Mon Sep 17 00:00:00 2001
From: kklouzal <2928845+kklouzal@users.noreply.github.com>
Date: Sat, 31 Oct 2026 12:21:53 -0700
Subject: [PATCH] Replace removed block pointers in NVFP4 activation fake
 quantization

Preserve the existing quantization arithmetic and masked edge behavior on Triton 3.9. Extend ragged and strided input coverage, and defer the unrelated MX extension acquisition until its own test runs. Source checks pass; native GPU verification remains pending the qualified test environment.

Signed-off-by: kklouzal <2928845+kklouzal@users.noreply.github.com>
---
 .../quantization/gemm/fp4_kernel_hopper.py    | 35 +++++++------------
 .../quantization/test_tensor_quant_cuda.py    | 30 ++++++++++++++--
 2 files changed, 39 insertions(+), 26 deletions(-)

diff --git a/modelopt/torch/kernels/quantization/gemm/fp4_kernel_hopper.py b/modelopt/torch/kernels/quantization/gemm/fp4_kernel_hopper.py
index 6f72f170..0aeda2fe 100644
--- a/modelopt/torch/kernels/quantization/gemm/fp4_kernel_hopper.py
+++ b/modelopt/torch/kernels/quantization/gemm/fp4_kernel_hopper.py
@@ -47,7 +47,7 @@ def fp4_fake_quant_kernel(
     NUM_FP4_BLOCKS: tl.constexpr,
     OUT_DTYPE: tl.constexpr,
 ):
-    """Applies FP4 fake quantization using block pointers for memory addressing.
+    """Applies FP4 fake quantization using masked pointers for memory addressing.
 
     Each run of ``ROWS_PER_SCALE`` rows uses its own global scale: all ``M`` rows share one for a
     single tensor, and each slice of a stacked tensor (e.g. one expert) has its own.
@@ -55,25 +55,14 @@ def fp4_fake_quant_kernel(
     pid_m = tl.program_id(axis=0)
     pid_n = tl.program_id(axis=1)
 
-    row_start = pid_m * TILE_M
-    col_start = pid_n * TILE_N
-
-    x_block_ptr = tl.make_block_ptr(
-        base=x_ptr,
-        shape=(M, N),
-        strides=(stride_xm, stride_xn),
-        offsets=(row_start, col_start),
-        block_shape=(TILE_M, TILE_N),
-        order=(1, 0),
-    )
-    y_block_ptr = tl.make_block_ptr(
-        base=y_ptr,
-        shape=(M, N),
-        strides=(stride_ym, stride_yn),
-        offsets=(row_start, col_start),
-        block_shape=(TILE_M, TILE_N),
-        order=(1, 0),
-    )
+    # Widen before offset arithmetic, including row strides for large tensors.
+    row_start = pid_m.to(tl.int64) * TILE_M
+    col_start = pid_n.to(tl.int64) * TILE_N
+    row_offsets = row_start + tl.arange(0, TILE_M)
+    col_offsets = col_start + tl.arange(0, TILE_N)
+    mask = (row_offsets[:, None] < M) & (col_offsets[None, :] < N)
+    x_ptrs = x_ptr + row_offsets[:, None] * stride_xm + col_offsets[None, :] * stride_xn
+    y_ptrs = y_ptr + row_offsets[:, None] * stride_ym + col_offsets[None, :] * stride_yn
 
     rows = tl.minimum(row_start + tl.arange(0, TILE_M), M - 1)  # padding rows reuse the last one
     global_scale = tl.load(global_scale_ptr + rows // ROWS_PER_SCALE).to(tl.float32)
@@ -81,7 +70,7 @@ def fp4_fake_quant_kernel(
     global_scale_valid = (global_scale > 0.0) & (global_scale < float("inf"))  # False for NaN
     global_scale_safe = tl.where(global_scale_valid, global_scale, 1.0)
 
-    tile = tl.load(x_block_ptr, boundary_check=(0, 1), padding_option="zero").to(tl.float32)
+    tile = tl.load(x_ptrs, mask=mask, other=0.0).to(tl.float32)
 
     tile_reshaped = tl.reshape(tile, (TILE_M, NUM_FP4_BLOCKS, BLOCK_SIZE))
     block_max = tl.max(tl.abs(tile_reshaped), axis=2, keep_dims=True)
@@ -93,7 +82,7 @@ def fp4_fake_quant_kernel(
     x_quant = nvfp4_scalar_quant(tile_reshaped, block_max_quant, BLOCK_SIZE)
     tile_quant = tl.reshape(x_quant, (TILE_M, TILE_N))
 
-    tl.store(y_block_ptr, tile_quant.to(OUT_DTYPE), boundary_check=(0, 1))
+    tl.store(y_ptrs, tile_quant.to(OUT_DTYPE), mask=mask)
 
 
 def fp4_fake_quant_block(
@@ -105,7 +94,7 @@ def fp4_fake_quant_block(
     num_warps: int | None = None,
     num_stages: int | None = None,
 ) -> torch.Tensor:
-    """FP4 fake quantization implementation using block-pointer tiling.
+    """FP4 fake quantization implementation using masked-pointer tiling.
 
     Args:
         x (torch.Tensor): Input tensor of shape ``(M, N)`` or higher.
diff --git a/tests/gpu/torch/quantization/test_tensor_quant_cuda.py b/tests/gpu/torch/quantization/test_tensor_quant_cuda.py
index 624dd24f..18f5b077 100644
--- a/tests/gpu/torch/quantization/test_tensor_quant_cuda.py
+++ b/tests/gpu/torch/quantization/test_tensor_quant_cuda.py
@@ -228,13 +228,14 @@ class Testfp4:
 
         assert torch.equal(output[-4096:], tail)
 
-    @pytest.mark.skipif(get_cuda_ext_mx() is None, reason="cuda_ext_mx is not available")
     @pytest.mark.parametrize(
         "set_torch_dtype", [torch.float, torch.float16, torch.bfloat16], indirect=True
     )
     @pytest.mark.parametrize("block_size", [8, 16, 32])
     def test_cuda_ext_fp4(self, set_torch_dtype, block_size):
         cuda_ext_mx = get_cuda_ext_mx()
+        if cuda_ext_mx is None:
+            pytest.skip("cuda_ext_mx is not available")
         # Test with e2m1 table values
         sign = torch.randint(0, 2, (1, 8)).cuda() * 2 - 1
 
@@ -381,6 +382,28 @@ class Testfp4:
             f"Max relative diff: {((output_static - output_dynamic).abs() / (output_dynamic.abs() + 1e-8)).max()}"
         )
 
+    @pytest.mark.skipif(
+        not hasattr(triton_kernel, "fp4_fake_quant_block"),
+        reason="fp4_fake_quant_block requires compute >= 8.9",
+    )
+    @pytest.mark.parametrize("dtype", [torch.float32, torch.float16, torch.bfloat16])
+    @pytest.mark.parametrize("shape", [(1, 17), (17, 70)])
+    def test_fp4_kernel_ragged_noncontiguous(self, dtype, shape):
+        """Ragged tiles and strided inputs retain the independent static-kernel contract."""
+        torch.manual_seed(42)
+        rows, cols = shape
+        x = torch.randn(rows, cols * 2, device="cuda").to(dtype)[:, ::2]
+        padded = torch.nn.functional.pad(x, (0, -cols % 16))
+        amax = padded.float().reshape(rows, -1, 16).abs().amax(dim=-1).reshape(-1)
+        global_amax = x.float().abs().amax()
+        expected = triton_kernel.static_blockwise_fp4_fake_quant(
+            padded, amax, global_amax, quantize_block_scales=True
+        )[:, :cols]
+        actual = triton_kernel.fp4_fake_quant_block(x, global_amax)
+        assert actual.shape == x.shape and actual.dtype == x.dtype
+        assert torch.allclose(actual, expected, rtol=1e-3, atol=1e-5)
+        assert torch.equal(actual, triton_kernel.fp4_fake_quant_block(x.contiguous(), global_amax))
+
     @pytest.mark.skipif(
         not hasattr(triton_kernel, "fp4_fake_quant_block"),
         reason="fp4_fake_quant_block requires compute >= 8.9",
@@ -404,12 +427,13 @@ class Testfp4:
         reason="fp4_fake_quant_block requires compute >= 8.9",
     )
     @pytest.mark.parametrize("dtype", [torch.float32, torch.float16, torch.bfloat16])
-    def test_fp4_kernel_per_slice_global_amax(self, dtype):
+    @pytest.mark.parametrize("cols", [64, 70])
+    def test_fp4_kernel_per_slice_global_amax(self, dtype, cols):
         """One global amax per index of dim 0 quantizes each slice as its own call would."""
         torch.manual_seed(0)
         # 10 rows per slice, so 16-row tiles span two slices.
         scale = torch.logspace(-2, 2, 6, device="cuda")[:, None, None]
-        x = (torch.randn(6, 10, 64, device="cuda") * scale).to(dtype)
+        x = (torch.randn(6, 10, cols * 2, device="cuda") * scale).to(dtype)[..., ::2]
         amax = x.float().abs().amax(dim=(1, 2))
         amax[1] *= 0.5  # saturating block scales
         amax[2] = 0.0  # invalid global amaxes use a unit scale
-- 
